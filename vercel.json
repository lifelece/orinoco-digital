{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "comment": "Los assets con hash en el nombre no cambian nunca: cache eterna. Es lo que hace que Cesium se descargue una sola vez.",
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "comment": "Assets estaticos de Cesium (workers, texturas, widgets). Tampoco cambian entre versiones.",
      "source": "/cesiumStatic/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "comment": "Los GeoJSON SI cambian al actualizar datos y no llevan hash. Una hora de cache con revalidacion: el CDN absorbe el trafico y una correccion de datos llega pronto.",
      "source": "/data/(.*).geojson",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "comment": "Cabeceras de seguridad basicas para un sitio estatico.",
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        }
      ]
    }
  ]
}
