# Copia este archivo a .env y rellena los valores.
# .env NUNCA se sube a git.

# --- Fase 0 (obligatorio) ---
# Token de Cesium ion. Crear cuenta Community gratis en https://ion.cesium.com/
# Al desplegar (Fase 6): crea un token SEPARADO restringido a tu dominio.
VITE_CESIUM_TOKEN=

# --- Fase 4 (dejar vacio hasta entonces) ---
# Solo la anon key, que es publica por diseno y va protegida por RLS.
# La service_role key NUNCA entra aqui ni en ningun archivo VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
