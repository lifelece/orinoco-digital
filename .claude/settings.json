{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run verificar:modulos)",
      "Bash(npm run data:validate)",
      "Bash(node --test *)",
      "Bash(node --import ./test/entorno.mjs --test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx *)",
      "Bash(npm run data:*)",
      "Bash(git push *)",
      "Bash(git commit *)",
      "Edit(/vercel.json)",
      "Edit(/package.json)",
      "Edit(/public/expofaja/**)",
      "Read(./data/raw/expofaja/privado/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(/.env)",
      "Edit(/.env.local)",
      "Edit(/public/data/*.geojson)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/verificar-post.mjs\""
          }
        ]
      }
    ]
  }
}
